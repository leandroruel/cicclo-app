@baseUrl = http://localhost:5000

### Get active services
GET {{baseUrl}}/api/v1/services

### Get a service by ID
GET {{baseUrl}}/api/v1/services/1

### Request a service that does not exist (404)
GET {{baseUrl}}/api/v1/services/999

### Get wallet
GET {{baseUrl}}/api/v1/wallet

### Get wallet by ID
GET {{baseUrl}}/api/v1/wallet/5b1f0c1e-7a34-4c53-9c0e-2f6f4a1d9a10

### Request a wallet that does not exist (404)
GET {{baseUrl}}/api/v1/wallet/00000000-0000-0000-0000-000000000000

### Get wallet transactions
GET {{baseUrl}}/api/v1/wallet/transactions

### Add R$ 50.00 to the wallet
POST {{baseUrl}}/api/v1/wallet/credits
Idempotency-Key: wallet-credit-50-example
Content-Type: application/json

{
  "amount": 50.00
}

### Retry the same credit safely with the same idempotency key and payload
POST {{baseUrl}}/api/v1/wallet/credits
Idempotency-Key: wallet-credit-50-example
Content-Type: application/json

{
  "amount": 50.00
}

### Reusing a key with a different amount returns 409 Conflict
POST {{baseUrl}}/api/v1/wallet/credits
Idempotency-Key: wallet-credit-50-example
Content-Type: application/json

{
  "amount": 25.00
}

### Create a laundry order
POST {{baseUrl}}/api/v1/orders
Idempotency-Key: 7ce7afde-b3c8-4c0f-b59a-f21d9a74f060
Content-Type: application/json

{
  "serviceId": 1
}

### Retry the same order with the same key; expect 200 and Idempotent-Replayed: true
POST {{baseUrl}}/api/v1/orders
Idempotency-Key: 7ce7afde-b3c8-4c0f-b59a-f21d9a74f060
Content-Type: application/json

{
  "serviceId": 1
}

### Reusing the order key for another service returns 422
POST {{baseUrl}}/api/v1/orders
Idempotency-Key: 7ce7afde-b3c8-4c0f-b59a-f21d9a74f060
Content-Type: application/json

{
  "serviceId": 2
}

### Requesting an unknown service returns 404
POST {{baseUrl}}/api/v1/orders
Idempotency-Key: 72312007-4576-4f7a-9761-a123b6b0c1a8
Content-Type: application/json

{
  "serviceId": 999
}
